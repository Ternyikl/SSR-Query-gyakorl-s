<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <style>
         input, select{
            margin-bottom: 10px;
            margin-top: 10px;
            display: inline-block;
        }
    </style>
</head>

<body>
    <h1>
        <%= title %>
    </h1>

    <form method="get">
        <label for="lang">
            Válasz nyelvet:
        </label>
        <select name="lang">
            <option value="hu">Magyar</option>
            <option value="en">English</option>
        </select>
        <br>
        <button type="submit">Submit</button>
    </form>

    <p><%= intro %></p>
</body>

</html>