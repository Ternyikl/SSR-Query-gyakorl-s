<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
         input{
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <h1><%= title %></h1>
    
    <form>
        <label for="a">a:</label>
        <input type="number" id="a" name="a" required>
        <br>
        <label for="b">b:</label>
        <input type="number" id="b" name="b" required>
        <br>
        <label for="c">c:</label>
        <input type="number" id="c" name="c" required>
        <br>
        <button type="submit">Submit</button>
    </form>

    <p>Az egyenlet megoldásai: <%= solution %></p>
    
</body>
</html>